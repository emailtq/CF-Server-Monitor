  "methods": [
    {
      "name": "hello",
      "kind": "notification",
      "senderRoles": [
        "agent"
      ],
      "receiverRoles": [
        "hub"
      ],
      "maxBytes": 65536,
      "paramsSchema": {
        "$ref": "#/definitions/facts"
      },
      "emitterRequired": [
        "hostname",
        "os",
        "kernel",
        "arch",
        "virt",
        "cpu_name",
        "cpu_cores",
        "agent_version",
        "ipv4",
        "ipv6"
      ],
      "emitterOptional": [
        "mem_total",
        "swap_total",
        "disk_total"
      ],
      "sources": [
        "facts",
        "hello",
        "receive",
        "factsStore"
      ],
      "upstreamReceive": "No fact is required by save_facts; missing/non-string text becomes empty, cpu_cores uses i64 fallback0. Current hub ignores hello capacities and records capacities from reports. Empty strings describe unknown facts. First hello includes three capacities for old hubs; fact-change hello omits them. Null is not emitted.",
      "examples": [
        {
          "valid": true,
          "note": "valid",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"hello\",\"params\":{\"hostname\":\"demo\",\"os\":\"Debian GNU/Linux 12\",\"kernel\":\"6.1\",\"arch\":\"x86_64\",\"virt\":\"kvm\",\"cpu_name\":\"demo CPU\",\"cpu_cores\":2,\"agent_version\":\"1.2.3\",\"ipv4\":\"\",\"ipv6\":\"\",\"mem_total\":1073741824,\"swap_total\":0,\"disk_total\":2147483648}}"
        }
      ],
      "schemaScope": "paramsSchema = normal portable emitted shape; receiverParamsSchema = actual parser shape; upstreamReceive = admission/ingestion effects",
      "receiverParamsSchema": {}
    },
    {
      "name": "report",
      "kind": "notification",
      "senderRoles": [
        "agent"
      ],
      "receiverRoles": [
        "hub"
      ],
      "maxBytes": 65536,
      "paramsSchema": {
        "$ref": "#/definitions/report"
      },
      "emitterRequired": [
        "boot_id",
        "iface",
        "uptime",
        "cpu",
        "load",
        "mem_total",
        "mem_used",
        "swap_total",
        "swap_used",
        "disk_total",
        "disk_used",
        "net_rx_total",
        "net_tx_total",
        "net_rx",
        "net_tx",
        "tcp",
        "udp",
        "procs"
      ],
      "sources": [
        "facts",
        "report",
        "traffic"
      ],
      "upstreamReceive": "Object required; all known fields may be missing (warn once). Present numeric public fields and counters must be finite nonnegative numbers: null/string/negative rejected. load must have 3 nonnegative numbers. boot_id/iface are not type-rejected; missing/empty/non-string boot_id disables traffic. Counters accepted as a usable pair only when nonnegative signed i64; floats or >i64 carry no traffic reading. Other numeric fields can be fractional at receive even when emitter is integer. No ACK; reception-time/session aggregation, report spacing 500ms. Unknown fields are not needed for standard use.",
      "examples": [
        {
          "valid": true,
          "note": "raw i64 counter",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"report\",\"params\":{\"boot_id\":\"boot-a/iface-a\",\"iface\":\"\",\"uptime\":3600,\"cpu\":12.5,\"load\":[0.1,0.2,0.3],\"mem_total\":1073741824,\"mem_used\":268435456,\"swap_total\":0,\"swap_used\":0,\"disk_total\":2147483648,\"disk_used\":1073741824,\"net_rx_total\":9007199254740993,\"net_tx_total\":7,\"net_rx\":100,\"net_tx\":200,\"tcp\":5,\"udp\":2,\"procs\":30}}"
        },
        {
          "valid": true,
          "note": "partial older report",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"report\",\"params\":{\"cpu\":1}}"
        },
        {
          "valid": false,
          "note": "counter string",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"report\",\"params\":{\"boot_id\":\"boot-a/iface-a\",\"iface\":\"\",\"uptime\":3600,\"cpu\":12.5,\"load\":[0.1,0.2,0.3],\"mem_total\":1073741824,\"mem_used\":268435456,\"swap_total\":0,\"swap_used\":0,\"disk_total\":2147483648,\"disk_used\":1073741824,\"net_rx_total\":\"9007199254740993\",\"net_tx_total\":7,\"net_rx\":100,\"net_tx\":200,\"tcp\":5,\"udp\":2,\"procs\":30}}"
        },
        {
          "valid": false,
          "note": "null numeric",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"report\",\"params\":{\"boot_id\":\"boot-a/iface-a\",\"iface\":\"\",\"uptime\":3600,\"cpu\":null,\"load\":[0.1,0.2,0.3],\"mem_total\":1073741824,\"mem_used\":268435456,\"swap_total\":0,\"swap_used\":0,\"disk_total\":2147483648,\"disk_used\":1073741824,\"net_rx_total\":9007199254740993,\"net_tx_total\":7,\"net_rx\":100,\"net_tx\":200,\"tcp\":5,\"udp\":2,\"procs\":30}}"
        }
      ],
      "schemaScope": "paramsSchema = normal portable emitted shape; receiverParamsSchema = actual parser shape; upstreamReceive = admission/ingestion effects",
