    {
      "name": "ping.result",
      "kind": "notification",
      "senderRoles": [
        "agent"
      ],
      "receiverRoles": [
        "hub"
      ],
      "maxBytes": 65536,
      "paramsSchema": {
        "$ref": "#/definitions/pingResult"
      },
      "sources": [
        "agentTasks",
        "receive",
        "pings",
        "agentTCP"
      ],
      "upstreamReceive": "Positive i64 task_id plus i64 latency_ms yields one reception-stamped result; any negative latency counts as lost upstream, emitter uses -1. Missing/null/noninteger latency yields no sample. DB verifies assignment. Results window max128/5s. Buffered same-task arrivals at one second are backdated >=1s apart to avoid replacing each other. No sender timestamp or ACK.",
      "examples": [
        {
          "valid": true,
          "note": "valid",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"ping.result\",\"params\":{\"task_id\":1,\"latency_ms\":42}}"
        },
        {
          "valid": true,
          "note": "timeout",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"ping.result\",\"params\":{\"task_id\":1,\"latency_ms\":-1}}"
        },
        {
          "valid": false,
          "note": "missing is not loss",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"ping.result\",\"params\":{\"task_id\":1,\"latency_ms\":null}}"
        }
      ],
      "schemaScope": "paramsSchema = normal portable emitted shape; receiverParamsSchema = actual parser shape; upstreamReceive = admission/ingestion effects",
      "receiverParamsSchema": {},
      "ingestionSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "integer",
            "minimum": 1,
            "unit": "identifier",
            "maximum": 9223372036854775807,
            "maximumDecimal": "9223372036854775807",
            "parsing": "raw decimal token -> BigInt/i64; public JSON remains numeric"
          },
          "latency_ms": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807,
            "unit": "milliseconds",
            "meaning": "all negative latencies count as lost in hub"
          }
        },
        "required": [
          "task_id",
          "latency_ms"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "ping.tasks",
      "kind": "notification",
      "senderRoles": [
        "hub"
      ],
      "receiverRoles": [
        "agent"
      ],
      "maxBytes": 65536,
      "paramsSchema": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/task"
        },
        "maxItems": 64
      },
      "sources": [
        "tasks",
        "taskBounds",
        "agentTasks"
      ],
      "upstreamReceive": "params is the whole array, not {tasks:[]}. Agent keeps first64 (upstream explicitly truncates), clamps interval to5..3600; changed tasks restart, unchanged keep timers. Hub checks assignment count64 and admin interval5..3600. Failed DB read emits no empty list in1.5.2 and retries at heartbeat.",
      "examples": [
        {
          "valid": true,
          "note": "valid",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"ping.tasks\",\"params\":[{\"id\":1,\"target\":\"example.com:443\",\"interval\":60}]}"
        },
        {
          "valid": true,
          "note": "remove all assigned tasks",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"ping.tasks\",\"params\":[]}"
        },
        {
          "valid": false,
          "note": "wrong shape",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"ping.tasks\",\"params\":{\"tasks\":[]}}"
        }
      ],
      "schemaScope": "paramsSchema = normal portable emitted shape; receiverParamsSchema = actual parser shape; upstreamReceive = admission/ingestion effects",
      "receiverParamsSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            "target": {
              "type": "string"
            },
            "interval": {
              "type": "integer",
              "minimum": 0,
              "unit": "seconds",
              "maximum": 18446744073709551615
            }
          },
          "required": [
            "id",
            "target",
            "interval"
          ],
          "additionalProperties": true
        }
      },
      "afterParse": {
        "maximumExecuted": 64,
        "intervalClamp": [
          5,
          3600
        ],
        "malformedArray": "ignore and keep previous list; no ACK",
