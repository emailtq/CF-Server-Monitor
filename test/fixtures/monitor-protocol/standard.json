          "type": "string"
        },
        "cpu_cores": {
          "type": "integer",
          "minimum": 0,
          "unit": "cores"
        },
        "agent_version": {
          "type": "string"
        },
        "ipv4": {
          "type": "string",
          "meaning": "own IPv4, empty when none"
        },
        "ipv6": {
          "type": "string",
          "meaning": "own IPv6, empty when none"
        },
        "mem_total": {
          "type": "integer",
          "minimum": 0,
          "unit": "bytes"
        },
        "swap_total": {
          "type": "integer",
          "minimum": 0,
          "unit": "bytes"
        },
        "disk_total": {
          "type": "integer",
          "minimum": 0,
          "unit": "bytes"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "report": {
      "type": "object",
      "properties": {
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "meaning": "opaque kernel boot + counted interface-set epoch; equality, not a timestamp"
        },
        "iface": {
          "type": "string",
          "meaning": "filter actually in force, empty = default; exact --iface grammar belongs to upstream collector"
        },
        "uptime": {
          "type": "integer",
          "minimum": 0,
          "unit": "seconds"
        },
        "cpu": {
          "type": "number",
          "minimum": 0,
          "unit": "percent"
        },
        "load": {
          "type": "array",
          "items": {
