  "transport": {
    "path": "/api/agent/ws",
    "scheme": "wss",
    "authentication": "Authorization: Bearer <node token>",
    "bearerLocation": "header only",
    "maxBytes": 65536,
    "heartbeatSeconds": 30,
    "silenceSeconds": 120,
    "handshake": "agent sends hello immediately; hub may send ping.tasks first; neither waits for legacy type:hello",
    "echoPath": "/api/agent/echo",
    "echoMeaning": "optional authenticated other-address-family observation; no second monitoring session or ledger",
    "upstreamSchemes": [
      "wss",
      "ws"
    ],
    "cfRequiresTLS": true,
    "upstreamCLI": {
      "intervalDefaultSeconds": 1,
      "intervalClampSeconds": [
        1,
        3600
      ],
      "insecure": "upstream --insecure permits remote plain ws; CF target keeps HTTPS/WSS security, never implicitly downgrades",
      "iface": "full names and -name exclusions; not CF glob syntax"
    }
  },
  "envelope": {
    "jsonrpc": "2.0",
    "params": "method-specific object or array",
    "id": "absent on all four emitted standard notifications",
    "result": "not emitted for notifications",
    "actualReceiver": "Rust Rpc deserializes method:String and params:Value(default null); it does not enforce jsonrpc/id or reject unknown envelope fields. CF codec will enforce JSON-RPC 2.0 without adding mandatory CF params.",
    "unknownNotification": "ignore; no response"
  },
  "definitions": {
    "facts": {
      "type": "object",
