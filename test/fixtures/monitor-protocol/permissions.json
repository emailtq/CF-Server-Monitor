      "lease capped60s and JWT expiry"
    ],
    "mapping": {
      "terminal_open": "broker-control cf.terminal.open after REST admission; no direct agent open call",
      "terminal_revoke_node": "broker-control cf.terminal.disable plus durable server revocation",
      "terminal_close": "broker closeSession -> broker-control cf.terminal.close",
      "terminal_renew": "same owner/authorization/expiry; no Agent-supplied lease"
    }
  },
  "security": {
    "capability": "intersection of exact offered/implemented versions; cf.capabilities itself requires auth but no prior negotiation",
    "route": "monitoring Agent cannot impersonate browser/broker/admin, including terminal methods that share agent name; role is trusted socket context",
    "revocation": "monitoring uses token_version; PTY adds credential_version, local consent, control generation, administrator owner lease/ticket; capability never substitutes",
    "credentials": "Bearer only in headers; no query/userinfo/report/config/public WS/logs. Terminal open ticket only private control plus session header, stored hashed/single-use.",
    "validation": "No arbitrary command, shell, code or executable URL field. Exact CF properties and sizes. Monitoring unknown request gets safe method error; monitoring unknown notification ignored. Invalid private terminal control closes its affected connection/session without RPC response to notification. Source/schema reference does not grant authority."
  }
